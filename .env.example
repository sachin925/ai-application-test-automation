# Base URL of the running ai-application instance.
BASE_URL=http://localhost:3000

# Path to the ai-application checkout; used by the Playwright webServer
# to auto-start the app when it is not already running.
APP_PATH=../ai-application

# Optional: enables the @real-llm spec against a real OpenAI model instead
# of the deterministic mock. Leave unset in normal development/CI.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
